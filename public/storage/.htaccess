# User uploads are data, never code: refuse to serve anything executable.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|shtml|cgi|pl|py|sh|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
